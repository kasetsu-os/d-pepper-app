function classifyConsult(text) {
  const v = text.toLowerCase();
  /* 不満・クレーム系：内部検知のみ、画面にカテゴリ名は表示しない */
  const COMPLAINT_KW = ["不満", "クレーム", "返金", "やり直し", "やりなおし", "苦情", "文句", "怒って", "怒りました", "謝罪", "賠償", "やりなおして", "やりなおしてほしい"];
  if (COMPLAINT_KW.some((kw) => v.includes(kw)))
    return { category: "__complaint__", summary: "", nextAction: "" };
  if (v.includes("円形") || v.includes("ハゲ") || v.includes("はげ") || v.includes("丸く抜け"))
    return { category: "円形脱毛症の相談", summary: "一部の抜け毛や頭皮状態についての相談として記録しました。", nextAction: "気になる状態が続く場合は、皮膚科へのご相談もご検討ください。以下からご希望の案内先をお選びください。" };
  if (v.includes("薄毛") || v.includes("抜け毛") || v.includes("抜毛") || v.includes("分け目") || v.includes("地肌") || v.includes("生え際"))
    return { category: "薄毛・抜け毛の相談", summary: "薄毛・抜け毛・分け目や地肌の見え方についてのご相談として記録しました。", nextAction: "気になる状態が続く場合は、皮膚科へのご相談もご検討ください。以下からご希望の案内先をお選びください。" };
  if (v.includes("頭皮") || v.includes("かゆ") || v.includes("フケ") || v.includes("赤み") || v.includes("しみる"))
    return { category: "頭皮の悩み", summary: "頭皮の状態や違和感に関する相談として記録しました。", nextAction: "以下からご希望の案内先をお選びください。" };
  if (v.includes("商品") || v.includes("シャンプー") || v.includes("トリートメント") || v.includes("ミルボン") || v.includes("オイル"))
    return { category: "商品相談", summary: "ホームケア商品や使い方に関する相談として記録しました。", nextAction: "以下からご希望の案内先をお選びください。" };
  if (v.includes("疲れ") || v.includes("リラックス") || v.includes("癒") || v.includes("眠") || v.includes("気分"))
    return { category: "疲れ・気分・リラックス", summary: "疲れや気分、リラックスに関する相談として記録しました。", nextAction: "以下からご希望の案内先をお選びください。" };
  if (v.includes("予約") || v.includes("メニュー") || v.includes("カラー") || v.includes("カット") || v.includes("パーマ") || v.includes("ストレート"))
    return { category: "メニュー・予約前の迷い", summary: "メニュー選びや予約前の迷いに関する相談として記録しました。", nextAction: "ヘアスタイルや施術内容の最終判断は、髪の状態を確認したうえでご案内します。ご予約時の備考欄にご記入いただくか、お急ぎの場合はお電話でご相談ください。" };
  if (v.includes("美容師") || v.includes("見学") || v.includes("働") || v.includes("求人") || v.includes("採用"))
    return { category: "美容師・見学希望", summary: "Da-isの見学や働き方に関するご相談として記録しました。", nextAction: "Da-isの雰囲気や働き方を知りたい方は、Instagramやnoteをご覧ください。\n見学をご希望の場合は、お電話にてお問い合わせください。" };
  if (v.includes("初めて") || v.includes("はじめて") || v.includes("不安") || v.includes("美容室"))
    return { category: "美容室選びの不安", summary: "美容室選びや来店前の不安に関する相談として記録しました。", nextAction: "以下からご希望の案内先をお選びください。" };
  return { category: "髪の悩み", summary: "髪や美容に関する相談として記録しました。", nextAction: "ヘアスタイルや施術内容の最終判断は、髪の状態を確認したうえでご案内します。ご予約時の備考欄にご記入いただくか、お急ぎの場合はお電話でご相談ください。" };
}

