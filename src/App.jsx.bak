import { useEffect, useMemo, useState } from "react";
import "./App.css";

const STORAGE_KEY = "d-pepper-consultations";

const ENTRIES = [
  {
    id: "first",
    title: "はじめての方",
    subtitle: "Da-isへようこそ",
    badge: "はじめての方",
    label: "はじめましてのご相談",
    sub: "気になることを、まとまっていないままでも大丈夫です。",
    icon: "leaf",
  },
  {
    id: "regular",
    title: "いつも来ている方",
    subtitle: "またお会いできて嬉しいです",
    badge: "いつも来ている方",
    label: "今日のご相談内容",
    sub: "いつものことでも、少し気になったことでも大丈夫です。",
    icon: "heart",
  },
  {
    id: "stylist",
    title: "美容師・見学希望の方",
    subtitle: "ご興味をお持ちいただきありがとうございます",
    badge: "美容師・見学希望",
    label: "ご興味の内容をお聞かせください",
    sub: "見学・働き方・技術について、気になることを書いてください。",
    icon: "scissors",
  },
];

function classifyConsult(text) {
  const v = text.toLowerCase();
  if (v.includes("円形") || v.includes("ハゲ") || v.includes("はげ") || v.includes("丸く抜け"))
    return { category: "円形脱毛症の相談", summary: "一部の抜け毛や頭皮状態についての相談として記録しました。", nextAction: "美容室で相談する／皮膚科に相談する／髪型・分け目・カバー方法を相談する／頭皮に配慮した施術相談／Da-isエステシャンプーについて見る" };
  if (v.includes("薄毛") || v.includes("抜け毛") || v.includes("抜毛") || v.includes("分け目") || v.includes("地肌") || v.includes("生え際"))
    return { category: "薄毛・抜け毛の相談", summary: "薄毛・抜け毛・分け目や地肌の見え方に関する相談として記録しました。", nextAction: "美容室で相談する／皮膚科に相談する／髪型・分け目・カバー方法を相談する／頭皮に配慮した施術相談／Da-isエステシャンプーについて見る" };
  if (v.includes("頭皮") || v.includes("かゆ") || v.includes("フケ") || v.includes("赤み") || v.includes("しみる"))
    return { category: "頭皮の悩み", summary: "頭皮の状態や違和感に関する相談として記録しました。", nextAction: "頭皮に配慮した施術相談／必要に応じて専門機関への相談も検討" };
  if (v.includes("商品") || v.includes("シャンプー") || v.includes("トリートメント") || v.includes("ミルボン") || v.includes("オイル"))
    return { category: "商品相談", summary: "ホームケア商品や使い方に関する相談として記録しました。", nextAction: "商品相談／milbon:iD外部リンク／店舗取置き相談" };
  if (v.includes("疲れ") || v.includes("リラックス") || v.includes("癒") || v.includes("眠") || v.includes("気分"))
    return { category: "疲れ・気分・リラックス", summary: "疲れや気分、リラックスに関する相談として記録しました。", nextAction: "Da-isエステシャンプーについて見る／メニュー相談" };
  if (v.includes("予約") || v.includes("メニュー") || v.includes("カラー") || v.includes("カット") || v.includes("パーマ") || v.includes("ストレート"))
    return { category: "メニュー・予約前の迷い", summary: "メニュー選びや予約前の迷いに関する相談として記録しました。", nextAction: "HotPepper予約ページへ／もう少し相談する" };
  if (v.includes("美容師") || v.includes("見学") || v.includes("働") || v.includes("求人") || v.includes("採用"))
    return { category: "美容師・見学相談", summary: "見学・働き方・美容師としての相談として記録しました。", nextAction: "見学・問い合わせ先へ" };
  if (v.includes("初めて") || v.includes("はじめて") || v.includes("不安") || v.includes("美容室"))
    return { category: "美容室選びの不安", summary: "美容室選びや来店前の不安に関する相談として記録しました。", nextAction: "もう少し相談する／HotPepper予約ページへ" };
  return { category: "髪の悩み", summary: "髪や美容に関する相談として記録しました。", nextAction: "もう少し相談する／メニュー相談／HotPepper予約ページへ" };
}

function Icon({ type }) {
  if (type === "heart") return (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="7.5" r="3.4" />
      <path d="M5.2 20.2c.5-4.2 3.2-6.8 6.8-6.8 1.5 0 2.9.45 4 1.25" />
      <path d="M17.35 15.2c.9-.9 2.35-.78 3.05.2.67.94.43 2.23-.45 3.08L17.35 21l-2.6-2.52c-.88-.85-1.12-2.14-.45-3.08.7-.98 2.15-1.1 3.05-.2Z" />
    </svg>
  );
  if (type === "scissors") return (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="6.4" cy="17.6" r="2.2" />
      <circle cx="16.8" cy="17.6" r="2.2" />
      <path d="M8.1 16.2 18.8 4.4" />
      <path d="M14.9 14.9 5.1 4.4" />
    </svg>
  );
  return (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 20V9.8" />
      <path d="M12 13.2C9.2 8.2 5.5 7 3.5 7c.2 3.4 2.1 6.3 5.9 7.1" />
      <path d="M12 11.4c2.2-4.3 5.4-5.8 8.3-5.8-.3 3.9-2.6 6.4-6.4 7.1" />
      <path d="M7.5 18.8h9" />
    </svg>
  );
}

function ArrowIcon() {
  return (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h13" /><path d="m13 6 6 6-6 6" />
    </svg>
  );
}

function App() {
  const [selectedEntry, setSelectedEntry] = useState(null);
  const [input, setInput] = useState("");
  const [consultations, setConsultations] = useState([]);
  const [historyOpen, setHistoryOpen] = useState(false);
  const [lastResult, setLastResult] = useState(null);

  useEffect(() => {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      setConsultations(Array.isArray(saved) ? saved : []);
    } catch { setConsultations([]); }
  }, []);

  useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(consultations));
  }, [consultations]);

  const currentEntry = useMemo(
    () => ENTRIES.find((e) => e.id === selectedEntry),
    [selectedEntry]
  );

  function openEntry(id) {
    setSelectedEntry(id);
    setInput("");
    setLastResult(null);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function goHome() {
    setSelectedEntry(null);
    setInput("");
    setLastResult(null);
  }

  function handleSubmit(e) {
    e.preventDefault();
    const text = input.trim();
    if (!text || !currentEntry) return;
    const result = classifyConsult(text);
    setConsultations((prev) => [
      {
        id: Date.now(),
        entryId: currentEntry.id,
        entryTitle: currentEntry.title,
        text,
        category: result.category,
        summary: result.summary,
        nextAction: result.nextAction,
        createdAt: new Date().toISOString(),
      },
      ...prev,
    ]);
    setLastResult(result);
    setInput("");
  }

  function formatDate(iso) {
    try {
      return new Intl.DateTimeFormat("ja-JP", {
        month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit",
      }).format(new Date(iso));
    } catch { return ""; }
  }

  return (
    <div className="画面">
      {/* 背景装飾 */}
      <div className="背景">
        <div className="背景_布" />
        <div className="背景_草" />
        <div className="背景_円弧"><span /></div>
        <div className="背景_ドット" />
      </div>

      {/* 中身 */}
      <div className="中身">
      {/* ヘッダー */}
      <header className="app-header">
        <div className="brand">
          <span className="brand-main">Da-is</span>
          <span className="brand-sub">相談窓口</span>
        </div>
        <button
          type="button"
          className="history-button"
          onClick={() => setHistoryOpen(true)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3.2 1.8" />
          </svg>
          <span>履歴</span>
          {consultations.length > 0 && (
            <span className="history-count">{consultations.length}</span>
          )}
        </button>
      </header>

      <main className="main-area">
        {/* ホームビュー */}
        {!selectedEntry && (
          <section className="home-view">
            <div className="hero">
              <h1>ご来店、ありがとうございます</h1>
              <div className="deco-line">
                <span className="deco-diamond" />
              </div>
              <p>今日はどのようなご相談ですか？</p>
            </div>
            <div className="entry-list">
              {ENTRIES.map((entry) => (
                <button
                  key={entry.id}
                  type="button"
                  className={`entry-card ${entry.id}`}
                  onClick={() => openEntry(entry.id)}
                >
                  <span className="entry-icon"><Icon type={entry.icon} /></span>
                  <span className="entry-text">
                    <span className="entry-title">{entry.title}</span>
                    <span className="entry-subtitle">{entry.subtitle}</span>
                  </span>
                  <span className="entry-arrow"><ArrowIcon /></span>
                </button>
              ))}
            </div>
          </section>
        )}

        {/* 相談ビュー */}
        {selectedEntry && currentEntry && (
          <section className="consult-view">
            <button type="button" className="back-button" onClick={goHome}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5" /><path d="m11 6-6 6 6 6" />
              </svg>
              <span>戻る</span>
            </button>
            <div className="consult-card">
              <div className="consult-badge">— {currentEntry.badge}</div>
              <h2>{currentEntry.label}</h2>
              <p className="consult-sub">{currentEntry.sub}</p>
              <form onSubmit={handleSubmit}>
                <textarea
                  value={input}
                  onChange={(e) => setInput(e.target.value)}
                  placeholder="例：最近、分け目の地肌が気になっています。"
                  rows={6}
                />
                <button type="submit" className="submit-button">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 2 11 13" /><path d="m22 2-7 20-4-9-9-4 20-7Z" />
                  </svg>
                  <span>送信・保存する</span>
                </button>
              </form>
              {lastResult && (
                <div className="result-card">
                  <span className="result-label">相談カテゴリ</span>
                  <h3>{lastResult.category}</h3>
                  <p>{lastResult.summary}</p>
                  <div className="next-action">
                    <span>次の案内</span>
                    <p>{lastResult.nextAction}</p>
                  </div>
                </div>
              )}
            </div>
          </section>
        )}
      </main>
      </div>{/* /中身 */}

      {/* 履歴パネル */}
      <div
        className={`overlay${historyOpen ? " is-open" : ""}`}
        onClick={() => setHistoryOpen(false)}
      />
      <aside className={`history-panel${historyOpen ? " is-open" : ""}`}>
        <div className="history-panel-header">
          <h2>履歴</h2>
          <button type="button" onClick={() => setHistoryOpen(false)}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6l12 12" /><path d="M18 6 6 18" />
            </svg>
          </button>
        </div>
        {consultations.length === 0 ? (
          <div className="history-empty">
            <p>まだ相談の記録はありません。</p>
            <span>相談すると、ここに静かに残ります。</span>
          </div>
        ) : (
          <div className="history-list">
            {consultations.map((item) => (
              <article className="history-item" key={item.id}>
                <div className="history-meta">
                  <span>{item.entryTitle}</span>
                  <time>{formatDate(item.createdAt)}</time>
                </div>
                <h3>{item.category}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        )}
      </aside>
    </div>
  );
}

export default App;
